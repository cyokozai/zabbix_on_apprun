FROM --platform=linux/amd64 zabbix/zabbix-web-nginx-mysql:latest

ARG DB_SERVER_HOST
ARG DB_SERVER_PORT
ARG MYSQL_USERNAME
ARG MYSQL_PASSWORD
ARG MYSQL_DATABASE

ENV DB_SERVER_HOST=${DB_SERVER_HOST}
ENV DB_SERVER_PORT=${DB_SERVER_PORT}
ENV MYSQL_USER=${MYSQL_USERNAME}
ENV MYSQL_PASSWORD=${MYSQL_PASSWORD}
ENV MYSQL_DATABASE=${MYSQL_DATABASE}
ENV PHP_TZ=Asia/Tokyo

ARG HTTP_PORT=8080
ENV PORT=$HTTP_PORT
EXPOSE $PORT

ARG HTTPS_PORT=8433
ENV PORT=$HTTPS_PORT
EXPOSE $PORT