FROM --platform=linux/amd64 zabbix/zabbix-server-mysql:latest

ARG DB_SERVER_HOST
ARG DB_SERVER_PORT
ARG MYSQL_USERNAME
ARG MYSQL_PASSWORD
ARG MYSQL_DATABASE

ENV DB_SERVER_HOST=${DB_SERVER_HOST}
ENV DB_SERVER_PORT=${DB_SERVER_PORT}
ENV MYSQL_USER=${MYSQL_USERNAME}
ENV MYSQL_PASSWORD=${MYSQL_PASSWORD}
ENV MYSQL_DATABASE=${MYSQL_DATABASE}

ARG PORT=10051
ENV PORT=$PORT
EXPOSE $PORT

# COPY ./scripts /usr/local/bin/scripts